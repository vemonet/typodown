{
  "name": "typodown",
  "displayName": "Typodown",
  "version": "0.0.4",
  "description": "View and edit Markdown with a seamless editor inspired by Typora.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "editor",
    "gfm",
    "markdown",
    "typora",
    "wysiwyg"
  ],
  "homepage": "https://typodown.app",
  "license": "MIT",
  "author": {
    "name": "Vincent Emonet",
    "email": "vincent.emonet@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vemonet/typodown.git",
    "directory": "apps/typodown-vsx"
  },
  "publisher": "vemonet",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "check": "vp check",
    "vscode:prepublish": "node build.mjs --production",
    "vsx:publish": "vsce package --no-dependencies --out typodown.vsix && vsce publish --packagePath typodown.vsix && ovsx publish typodown.vsix"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.84.0",
    "@vemonet/typodown": "*",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "ovsx": "^1.0.2",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.0"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "typodown.editor",
        "displayName": "Typodown",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "typodown.openWith",
        "title": "Open with Typodown",
        "category": "Typodown",
        "icon": "logo.png"
      },
      {
        "command": "typodown.openToSide",
        "title": "Open with Typodown to the Side",
        "category": "Typodown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "typodown.openWith",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "typodown.openWith",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Typodown",
      "properties": {
        "typodown.theme": {
          "type": "string",
          "enum": [
            "editor",
            "light",
            "dark",
            "dracula",
            "nord",
            "solarized-light",
            "solarized-dark"
          ],
          "enumDescriptions": [
            "Follow the current VS Code color theme",
            "Typodown light (GitHub light)",
            "Typodown dark (GitHub dark)",
            "Dracula",
            "Nord",
            "Solarized Light",
            "Solarized Dark"
          ],
          "default": "editor",
          "description": "Color theme for the Typodown markdown editor."
        },
        "typodown.joinSoftBreaks": {
          "type": "boolean",
          "default": true,
          "description": "Render a paragraph that is hard-wrapped in the source as one flowing paragraph, joining its lines with a space (a single newline is a soft line break in Markdown). Turn off to keep every source line on its own visual line. A hard break (two trailing spaces) always breaks the line."
        },
        "typodown.tabSize": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Number of spaces one indent level uses in the Typodown editor: what Tab inserts and Shift+Tab removes."
        }
      }
    }
  },
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.84.0"
  }
}
