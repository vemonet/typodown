{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typodown",
  "version": "0.1.0",
  "identifier": "io.github.vemonet.typodown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Typodown",
        "width": 1200,
        "height": 800,
        "minWidth": 320,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "androidIntentActionFilters": ["view"]
      }
    ]
  }
}
