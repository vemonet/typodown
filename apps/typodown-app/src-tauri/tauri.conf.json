{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typodown",
  "mainBinaryName": "Typodown",
  "version": "0.0.3",
  "identifier": "io.github.vemonet.typodown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Typodown",
        "width": 1200,
        "height": 800,
        "minWidth": 320,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Vincent Emonet",
    "category": "Productivity",
    "shortDescription": "Markdown editor",
    "longDescription": "Typodown blends reading and writing markdown into one continuous motion: markdown renders where you type, with the raw syntax revealed only under the cursor. No preview pane, no mode to toggle.",
    "homepage": "https://github.com/vemonet/typodown",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "name": "Markdown",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "androidIntentActionFilters": ["view"]
      }
    ]
  }
}
