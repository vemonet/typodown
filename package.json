{
  "name": "typodown",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.3",
    "bumpp": "^11.1.0",
    "eslint-plugin-solid": "^0.14.5",
    "git-cliff": "^2.13.1",
    "jsdom": "^29.1.1",
    "vite-plus": "0.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "fsevents@2.3.3": true
  }
}
